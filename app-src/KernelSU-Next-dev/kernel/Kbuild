ifdef KBUILD_EXTMOD
ifeq ($(CONFIG_XFG_DISABLE_MANAGER),y)
ccflags-y += -DCONFIG_XFG_DISABLE_MANAGER=1
endif
ifeq ($(CONFIG_XFG_DISABLE_POLICY),y)
ccflags-y += -DCONFIG_XFG_DISABLE_POLICY=1
endif
ifeq ($(CONFIG_XFG_DEBUG),y)
ccflags-y += -DCONFIG_XFG_DEBUG=1
endif
ifeq ($(CONFIG_XFG_X86_PATCH_SYSCALL_DISPATCHER),y)
ccflags-y += -DCONFIG_XFG_X86_PATCH_SYSCALL_DISPATCHER=1
endif
endif

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
XFG_KERNEL_DIR := $(srcroot)
else
XFG_KERNEL_DIR := $(KBUILD_EXTMOD)
endif
else ifeq ($(filter /%,$(src)),)
XFG_KERNEL_DIR := $(srctree)/$(src)
else
XFG_KERNEL_DIR := $(src)
endif

ccflags-y += -I$(XFG_KERNEL_DIR) -I$(XFG_KERNEL_DIR)/include

# preinit runner: a static nolibc binary embedded into xiaofeng, see preinit/.
# It is built against the installed UAPI headers of the target kernel
# (CONFIG_HEADERS_INSTALL, enabled by gki_defconfig).
XFG_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(XFG_UAPI_INC)/linux/unistd.h),)
xiaofeng-objs += preinit/preinit.o
xiaofeng-objs += preinit/blob.o

XFG_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(XFG_KERNEL_DIR)/preinit/runner/nolibc -I$(XFG_UAPI_INC) \
	-I$(XFG_KERNEL_DIR)/include \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

quiet_cmd_xfg_runner = RUNNER  $@
      cmd_xfg_runner = $(CC) $(XFG_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(XFG_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(XFG_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(XFG_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(XFG_KERNEL_DIR)/include/uapi/*.h) FORCE
	$(call if_changed,xfg_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DXFG_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- XiaoFeng: $(XFG_UAPI_INC) not found, preinit disabled)
ccflags-y += -DXFG_NO_PREINIT
endif

obj-$(CONFIG_XFG) += xiaofeng.o

LPATH := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin
MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(LPATH) git rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(LPATH) git rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(LPATH) git fetch --unshallow 2>/dev/null || true)
XFG_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(LPATH) git rev-list --count HEAD 2>/dev/null)
XFG_GIT_TAG := $(shell cd $(GIT_ROOT) && $(LPATH) git describe --tags --abbrev=0 2>/dev/null)
XFG_GIT_VERSION_VALID := 1
$(info -- XiaoFeng-Next Git repo detected at: $(GIT_ROOT))
endif
endif

# Calculate version if git version is available
ifdef XFG_GIT_VERSION_VALID
# xfg_version: major * 30000 + git version for historical reasons
$(eval XFG_VERSION=$(shell expr 30000 + $(XFG_GIT_VERSION)))
$(info -- XiaoFeng-Next version: $(XFG_VERSION))
ccflags-y += -DXFG_VERSION=$(XFG_VERSION)
else
# If there is no .git directory, use default version
$(warning "XFG_GIT_VERSION not defined! It is better to make XiaoFeng-Next a git repository!")
XFG_VERSION_FALLBACK := 1
$(info -- XiaoFeng-Next version fallback: $(XFG_VERSION_FALLBACK))
ccflags-y += -DXFG_VERSION=$(XFG_VERSION_FALLBACK)
endif

ifdef XFG_GIT_VERSION_VALID
$(eval XFG_VERSION_TAG=$(XFG_GIT_TAG))
$(info -- XiaoFeng-Next tag: $(XFG_VERSION_TAG))
ccflags-y += -DXFG_VERSION_TAG=\"$(XFG_VERSION_TAG)\"
else
$(warning "XFG_VERSION_TAG not defined! It is better to make XiaoFeng-Next a git submodule!")
XFG_VERSION_TAG_FALLBACK := v0.0.1
$(info -- XiaoFeng-Next tag fallback: $(XFG_VERSION_TAG_FALLBACK))
ccflags-y += -DXFG_VERSION_TAG=\"$(XFG_VERSION_TAG_FALLBACK)\"
endif

XFG_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- XiaoFeng-Next new DCACHE flush: $(XFG_NEW_DCACHE_FLUSH))

ifndef XFG_NEXT_MANAGER_SIZE
XFG_NEXT_MANAGER_SIZE := 0x3e6
endif

ifndef XFG_NEXT_MANAGER_HASH
XFG_NEXT_MANAGER_HASH := 79e590113c4c4c0c222978e413a5faa801666957b1212a328e46c00c69821bf7
endif

ifdef XFG_MANAGER_PACKAGE
ccflags-y += -DXFG_MANAGER_PACKAGE=\"$(XFG_MANAGER_PACKAGE)\"
$(info -- XiaoFeng-Next Manager package name: $(XFG_MANAGER_PACKAGE))
endif

$(info -- XiaoFeng-Next Manager signature size: $(XFG_NEXT_MANAGER_SIZE))
$(info -- XiaoFeng-Next Manager signature hash: $(XFG_NEXT_MANAGER_HASH))

ccflags-y += -DEXPECTED_MANAGER_SIZE=$(XFG_NEXT_MANAGER_SIZE)
ccflags-y += -DEXPECTED_MANAGER_HASH=\"$(XFG_NEXT_MANAGER_HASH)\"

ccflags-y += -DXFG_NEW_DCACHE_FLUSH=$(XFG_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes -Wno-missing-declarations
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function -Wno-unused-variable

